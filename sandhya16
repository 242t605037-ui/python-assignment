# Python Assignment
# Basic Python Programs and Problem Solving


def check_even_odd():
    number = int(input("Enter a number: "))

    if number % 2 == 0:
        print(number, "is Even")
    else:
        print(number, "is Odd")


def find_largest():
    a = int(input("Enter first number: "))
    b = int(input("Enter second number: "))
    c = int(input("Enter third number: "))

    largest = max(a, b, c)
    print("Largest number:", largest)


def calculate_sum():
    n = int(input("Enter a number: "))
    total = 0

    for i in range(1, n + 1):
        total += i

    print("Sum:", total)


def multiplication_table():
    number = int(input("Enter a number: "))

    for i in range(1, 11):
        print(number, "x", i, "=", number * i)


def factorial():
    number = int(input("Enter a number: "))
    result = 1

    for i in range(1, number + 1):
        result *= i

    print("Factorial:", result)


def main():
    while True:
        print("\n===== Python Assignment =====")
        print("1. Check Even or Odd")
        print("2. Find Largest Number")
        print("3. Calculate Sum")
        print("4. Multiplication Table")
        print("5. Find Factorial")
        print("6. Exit")

        choice = input("Enter your choice: ")

        if choice == "1":
            check_even_odd()
        elif choice == "2":
            find_largest()
        elif choice == "3":
            calculate_sum()
        elif choice == "4":
            multiplication_table()
        elif choice == "5":
            factorial()
        elif choice == "6":
            print("Thank you!")
            break
        else:
            print("Invalid choice. Please try again.")


if __name__ == "__main__":
    main()
